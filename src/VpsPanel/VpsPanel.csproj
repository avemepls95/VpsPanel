<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>VpsPanel</RootNamespace>
    <AssemblyName>VpsPanel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VpsPanel.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <PropertyGroup>
    <WebProjectDir>$(MSBuildProjectDirectory)\..\VpsPanel.Web</WebProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Frontend files appear after the project items are evaluated, so they are added to Content inside a target. -->
  <Target Name="BuildWeb" BeforeTargets="AssignTargetPaths" Condition="'$(_IsPublishing)' == 'true'">
    <Exec WorkingDirectory="$(WebProjectDir)" Command="npm ci" />
    <Exec WorkingDirectory="$(WebProjectDir)" Command="npm run build" />
    <ItemGroup>
      <Content Include="wwwroot\**" Exclude="@(Content)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
