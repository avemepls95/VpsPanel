<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>VpsPanel</RootNamespace>
    <AssemblyName>VpsPanel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VpsPanel.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <PropertyGroup>
    <WebProjectDir>$(MSBuildProjectDirectory)\..\VpsPanel.Web</WebProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The project items are evaluated before the frontend build, which replaces the files in wwwroot,
       so the wwwroot part of Content is collected again inside a target. A wildcard in Remove inside a target
       matches only files that are still on disk, so the old items are picked by their path. -->
  <Target Name="BuildWeb" BeforeTargets="AssignTargetPaths" Condition="'$(_IsPublishing)' == 'true'">
    <Exec WorkingDirectory="$(WebProjectDir)" Command="npm ci" />
    <Exec WorkingDirectory="$(WebProjectDir)" Command="npm run build" />
    <ItemGroup>
      <_OldWebContent Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').StartsWith('wwwroot\'))" />
      <Content Remove="@(_OldWebContent)" />
      <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
